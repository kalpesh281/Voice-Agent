# Platform MongoDB (our data: client configs, bookings, checkpoints)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=voice_agent

# Client's MongoDB (for testing — normally loaded from client config)
CLIENT_DB_URI=mongodb+srv://<user>:<pass>@client-cluster.mongodb.net/?retryWrites=true&w=majority
CLIENT_DB_NAME=hotel_data

# OpenAI (LLM via LangChain)
OPENAI_API_KEY=sk-...

# Deepgram (STT + TTS) — needed for voice mode
DEEPGRAM_API_KEY=

# Security
ENCRYPTION_KEY=

# Active client ID
CLIENT_ID=grand-meridian-palace
